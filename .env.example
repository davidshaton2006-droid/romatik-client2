# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIG
# These values are already embedded in src/lib/firebase/config.ts
# They connect to the same Firestore as the staff app (nimble-cairn-ssx2c)
VITE_FIREBASE_PROJECT_ID="nimble-cairn-ssx2c"
VITE_FIREBASE_API_KEY="AIzaSyBAgqdJMxuAEFTPSSHvpUkIkVV0712X7vA"
VITE_FIREBASE_STORAGE_BUCKET="nimble-cairn-ssx2c.firebasestorage.app"

# PAYMENTS API
# URL of the Cloudflare Worker that creates YooKassa payments (see /worker).
# The YooKassa shop id and secret key live ONLY as Worker secrets
# (`wrangler secret put`) — never as VITE_ variables, since those end up in
# the client-side bundle.
VITE_PAYMENTS_API_URL="https://romantik-baza-payments.YOUR_SUBDOMAIN.workers.dev"
