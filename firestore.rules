rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaffUser() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['employee', 'marketing', 'management'];
    }

    function isManagement() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'management';
    }

    // Validate booking data structure
    function isValidBooking(data) {
      return data.keys().hasAll([
        'house_type', 'check_in', 'check_out',
        'guest_last_name', 'guest_phone', 'prepayment',
        'created_at', 'created_by', 'created_by_name'
      ]) &&
      // Check data types
      data.house_type is string &&
      data.check_in is string &&
      data.check_out is string &&
      data.guest_last_name is string &&
      data.guest_phone is string &&
      data.prepayment is number &&
      data.total_price is number &&
      // Validate dates format (YYYY-MM-DD)
      data.check_in.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      data.check_out.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      // Validate phone format (at least 10 digits when cleaned)
      data.guest_phone.matches('^[\\d\\s\\-\\+\\(\\)]+$') &&
      data.guest_phone.trim().size() >= 10 &&
      // Validate guest name (not empty, reasonable length)
      data.guest_last_name.trim().size() >= 2 &&
      data.guest_last_name.trim().size() <= 100 &&
      // Validate prices
      data.prepayment >= 0 &&
      data.total_price >= data.prepayment &&
      data.total_price <= 1000000;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Unauthenticated clients can WRITE (create new bookings)
      // Authenticated staff can READ
      allow create: if !isAuthenticated() && isValidBooking(request.resource.data);
      allow read: if isStaffUser();
      allow update: if isStaffUser();
      allow delete: if isManagement();
      allow list: if isStaffUser();
    }

    // Booking history (archive)
    match /booking_history/{bookingId} {
      allow read: if isStaffUser();
      allow write: if isStaffUser();
      allow list: if isStaffUser();
    }

    // Users collection (staff profiles)
    match /users/{userId} {
      // Staff can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Management can read all user profiles
      allow read: if isManagement();
      // Management can write (update, create user profiles)
      allow write: if isManagement();
      allow list: if isManagement();
    }

    // Expenses collection
    match /expenses/{expenseId} {
      // Only staff can read/write expenses
      allow read: if isStaffUser();
      allow write: if isStaffUser();
      allow delete: if isManagement();
      allow list: if isStaffUser();
    }

    // Income collection
    match /income/{incomeId} {
      // Only staff can read/write income records
      allow read: if isStaffUser();
      allow write: if isStaffUser();
      allow delete: if isManagement();
      allow list: if isStaffUser();
    }

    // Analytics collection (read-only for all staff)
    match /analytics/{document=**} {
      allow read: if isStaffUser();
      allow write: if isManagement();
    }

    // Settings collection (only management can access)
    match /settings/{document=**} {
      allow read: if isManagement();
      allow write: if isManagement();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
